# Material shader for rendering materials
version = 1.0.0
name = Fox_Fire_Material_Shader
renderpass = Fox_Fire_World_Renderpass
stages = vertex, fragment
stagefiles = ../Shaders/Engine_World_Shader.vert.spv, ../Shaders/Engine_World_Shader.frag.spv
use_instance = true
use_local = true

#Attributes: Type,Name
attribute = Vector3, in_position
attribute = Vector3, in_normal
attribute = Vector2, in_texcoord
attribute = Vector4, in_color
attribute = Vector4, in_tangent

#Uniforms: Type,Scope,Name
#Scope: 0 = Global, 1 = Instance, 2 = Local
uniform = Matrix4, 0, projection
uniform = Matrix4, 0, view
uniform = Vector4, 0, ambient_color
uniform = Vector3, 0, view_position
uniform = Vector4, 1, diffuse_color
uniform = sampler, 1, diffuse_texture
uniform = sampler, 1, specular_texture
uniform = sampler, 1, normal_texture
uniform = float, 1, shine
uniform = Matrix4, 2, model